{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarkov-map-locator-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "EncryptedRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EncryptedRoom"] }],
  "observability": { "enabled": true }
}
