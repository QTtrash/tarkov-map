{
  "name": "raid-signal",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": "22.23.x",
    "npm": "11.14.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:web": "tsc -b && vite build --mode web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src relay/src scripts vite.config.ts playwright.config.ts",
    "format": "prettier --write --ignore-unknown . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check --ignore-unknown . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check:relay": "npm --prefix relay test && npm --prefix relay run build",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check:all": "npm run format:check && npm run lint && npm test && npm run build:desktop && npm run build:web && npm run check:relay && npm run check:rust && npm run assets:verify && npm audit --audit-level=high && npm --prefix relay audit --audit-level=high",
    "assets:sync": "node scripts/sync-tarkov-assets.mjs && node scripts/sync-community-raster-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "release:manifest": "node scripts/fetch-release-manifest.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.6",
    "@noble/ciphers": "^2.3.0",
    "@tauri-apps/api": "^2.8.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
