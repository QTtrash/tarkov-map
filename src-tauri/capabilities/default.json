{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main locator window",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://escapefromtarkov.fandom.com/wiki/*" }]
    }
  ]
}
